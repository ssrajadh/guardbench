# Copy to .env (gitignored) or export these in your shell before running
# the harness. The runner does not auto-load .env — use `set -a; . .env; set +a`
# or your shell-rc / direnv.

# Required for the Snyk Agent Scan adapter.
# Create one at https://app.snyk.io/account (free tier is fine for benchmarking).
SNYK_TOKEN=

# Required for the Cisco LLM and Hybrid adapters (mcp-scanner --analyzers
# llm / yara,llm). The scanner reads these directly via LiteLLM, so any
# LiteLLM-supported provider works. Defaults below point at NVIDIA NIM,
# which exposes OpenAI-compatible endpoints under a free tier.
#
# - API key: get one at https://build.nvidia.com (login → "Generate API Key").
# - Model: use any LiteLLM-recognized id. For NIM, prefix with `openai/`
#   so LiteLLM uses its OpenAI-compatible client. Llama 3.3 70B is fast
#   and free on NIM; swap for any other model id available there.
# - Base URL: NIM's OpenAI-compatible endpoint. Change if using a
#   different provider.
MCP_SCANNER_LLM_API_KEY=
MCP_SCANNER_LLM_MODEL=openai/meta/llama-3.3-70b-instruct
MCP_SCANNER_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Disable mcp-scanner's internal LLM retry loop (default 3). Without this,
# rate-limited LLM calls retry inside mcp-scanner AND inside any outer
# retry loop the harness applies — compounding 9x and producing
# malformed_json errors when the provider returns an HTML error page.
MCP_SCANNER_LLM_MAX_RETRIES=1
